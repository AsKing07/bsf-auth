# Copier ce fichier en .env et renseigner les valeurs en local.
# .env n'est JAMAIS versionné. Ce fichier ne contient aucune valeur réelle.
# Proposition initiale, à ajuster avec l'ADR-002 (BSF-44) et le ticket BSF-11.

DB_URL=jdbc:postgresql://localhost:5432/bsf_auth
DB_USER=
DB_PASSWORD=

# Premier administrateur : créé par migration, changement de mot de passe obligatoire à la première connexion
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Envoi des liens à usage unique par e-mail (API HTTP). En local : collecteur de mails (Mailpit).
MAIL_API_URL=
MAIL_API_KEY=

# Signature des jetons : la clé privée n'est jamais versionnée, seule la clé publique est exposée (JWKS)
JWT_SIGNING_KEY_PATH=
